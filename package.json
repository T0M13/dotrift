{
  "name": "dotrift",
  "version": "1.1.0",
  "description": "Dot-repulsion particle effect for images. Works with vanilla JS, React, Vue, Svelte, and any framework.",
  "author": "Tamas Illes",
  "license": "MIT",
  "homepage": "https://t0m13.github.io/dotrift/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T0M13/dotrift.git"
  },
  "bugs": "https://github.com/T0M13/dotrift/issues",
  "keywords": [
    "canvas", "particles", "animation", "hover", "effect",
    "react", "vue", "svelte", "interactive"
  ],
  "main": "./dotrift.umd.js",
  "module": "./src/dotrift.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/dotrift.js",
      "require": "./dotrift.umd.js",
      "types": "./types/index.d.ts"
    },
    "./react": {
      "import": "./react/index.jsx",
      "types": "./types/react.d.ts"
    }
  },
  "files": [
    "src",
    "react",
    "types",
    "dotrift.umd.js",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "sideEffects": false
}
